<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Relay.Setup</RootNamespace>
    <AssemblyName>RelaySetup</AssemblyName>
    <AssemblyTitle>RELAY Setup</AssemblyTitle>
    <Description>Installs RELAY for the current user.</Description>
    <ApplicationIcon>..\Relay.App\Assets\relay.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single, self-contained Setup.exe: nothing else needs to be installed first. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Relay.Core\Relay.Core.csproj" />
    <ProjectReference Include="..\Relay.Installer\Relay.Installer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Relay.App\Assets\relay.png" Link="Assets\relay.png" />
    <!-- The RELAY app itself, zipped by publish.sh. -->
    <EmbeddedResource Include="..\..\installer\payload\relay-payload.zip" LogicalName="payload.zip"
                      Condition="Exists('..\..\installer\payload\relay-payload.zip')" />
  </ItemGroup>
</Project>
