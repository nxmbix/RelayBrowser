<Window x:Class="Relay.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove RELAY" Width="532" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#1B1F23" Icon="/Assets/relay.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="U.Teal" Color="#1F7A6D"/>
        <SolidColorBrush x:Key="U.Muted" Color="#5C646C"/>
        <SolidColorBrush x:Key="U.Line" Color="#E4E7EA"/>
        <SolidColorBrush x:Key="U.Field" Color="#F3F5F6"/>

        <Style x:Key="U.Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C4443B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="U.Secondary" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource U.Line}" BorderThickness="1" CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource U.Field}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="U.Toggle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="#D5DADE">
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#C4443B"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="18" Background="White" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.28" Color="#0B1A17"/>
        </Border.Effect>
        <StackPanel Margin="36,32,36,30">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/relay.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="RELAY" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Confirm -->
            <StackPanel x:Name="ConfirmPanel" Margin="0,22,0,0">
                <TextBlock Text="Remove RELAY?" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource U.Muted}" FontSize="14" LineHeight="21" Margin="0,8,0,20"
                           Text="RELAY and its shortcuts will be removed from this PC. Open RELAY windows will be closed."/>
                <Border Background="{StaticResource U.Field}" CornerRadius="12" Padding="16,14">
                    <CheckBox x:Name="RemoveDataCheck" Style="{StaticResource U.Toggle}">
                        <StackPanel>
                            <TextBlock Text="Also delete my browsing data" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource U.Muted}" FontSize="12.5" Margin="0,2,0,0"
                                       Text="History, bookmarks, saved passwords, cookies and settings. Leave this off if you might reinstall."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                    <Button Style="{StaticResource U.Secondary}" Content="Cancel" IsCancel="True" Click="OnCancel"/>
                    <Button x:Name="RemoveButton" Style="{StaticResource U.Primary}" Content="Remove" Margin="12,0,0,0" Click="OnRemove"/>
                </StackPanel>
            </StackPanel>

            <!-- Done -->
            <StackPanel x:Name="DonePanel" Margin="0,22,0,0" Visibility="Collapsed">
                <TextBlock x:Name="DoneTitle" Text="RELAY was removed" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="DoneText" TextWrapping="Wrap" Foreground="{StaticResource U.Muted}" FontSize="14" LineHeight="21" Margin="0,8,0,0"
                           Text="Thanks for trying it. The program folder is cleaned up a few seconds after this window closes."/>
                <Button Style="{StaticResource U.Secondary}" Content="Close" HorizontalAlignment="Right" Margin="0,26,0,0" Click="OnCancel" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
