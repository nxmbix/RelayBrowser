<Window x:Class="Relay.App.Views.SearchChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to RELAY" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="/Assets/relay.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <StackPanel Margin="32,30,32,26">
        <Image Source="/Assets/relay.png" Width="44" Height="44" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Choose your search engine" Style="{StaticResource Text.Title}" Margin="0,18,0,6"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="20"
                   Text="RELAY uses it when you type a search into the address bar or the new tab page. The order below is shuffled, and you can change it any time in Settings."/>

        <ListBox x:Name="Engines" Margin="0,18,0,0" Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource Brush.Text}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSelectionChanged"
                 KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Search engines">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Margin="0,0,0,8" Padding="14,11" CornerRadius="12" Cursor="Hand"
                                        Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="Transparent" BorderThickness="1.5">
                                    <ContentPresenter TextElement.Foreground="{DynamicResource Brush.Text}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{Binding Tint}" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Grid DockPanel.Dock="Right" Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.AccentText}" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Margin="0,10,0,0">
            <Button x:Name="ContinueButton" DockPanel.Dock="Right" Content="Continue" Style="{StaticResource Button.Primary}"
                    MinWidth="120" IsDefault="True" IsEnabled="False" Click="OnContinue"/>
            <TextBlock x:Name="Hint" Text="Pick one to continue." VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"/>
        </DockPanel>
    </StackPanel>
</Window>
