<Application x:Class="Relay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Relay.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <c:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <c:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
            <c:BoolToVisibilityConverter x:Key="BoolToVisHidden" UseHidden="True"/>
            <c:NullToVisibilityConverter x:Key="NullToVis"/>
            <c:NullToVisibilityConverter x:Key="NullToVisInverted" Invert="True"/>
            <c:SecurityGlyphConverter x:Key="SecurityGlyph"/>
            <c:EnumEqualsConverter x:Key="EnumEquals"/>
            <c:EnumMatchConverter x:Key="EnumMatch"/>
            <c:PercentConverter x:Key="Percent"/>
            <c:EnumToVisibilityConverter x:Key="EnumToVis"/>
            <c:PositiveToVisibilityConverter x:Key="PositiveToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
